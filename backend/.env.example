# PCafe 2025 Backend Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pcafe2025
DB_USER=postgres
DB_PASSWORD=password
DB_SSLMODE=disable

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENV=development

# Cloudflare Turnstile (required for contact form)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production

# Email Configuration (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@prototype-cafe.space

# Optional: TimescaleDB specific settings
TIMESCALE_COMPRESSION_DAYS=7
TIMESCALE_RETENTION_DAYS=730